<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/battery_widget_card"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="4dp">
    <FrameLayout
        android:id="@+id/battery_widget_surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_card_light"
        android:clipToOutline="true">
        <include layout="@layout/battery_widget_artwork" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingHorizontal="5dp"
            android:paddingVertical="6dp">
            <ImageView
                android:id="@+id/battery_ring"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:scaleType="fitCenter"
                android:importantForAccessibility="no" />
            <TextView
                android:id="@+id/battery_caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:textSize="11sp"
                android:importantForAccessibility="no" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
